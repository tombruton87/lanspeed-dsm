# What the setup container writes to .env beside compose.yaml.
HTTP_PORT=8790                       # the browser speed test (LibreSpeed)
LAN_IP=192.168.1.20
TZ=Europe/London
APP_URL=http://192.168.1.20:8790
SSL_PROXY=0
IPERF_PORT=5201                      # the iperf3 server, TCP and UDP
LS_IMAGE=ghcr.io/librespeed/speedtest:6.3.0-alpine
IP_IMAGE=lanspeed-iperf3:local       # built on the Synology from setup/iperf3
LS_STATS_PASSWORD=…                  # locks LibreSpeed's own results page; the window shows the results
SCHED_EVERY=off                      # off | 15m | 30m | 1h | 3h | 6h | 12h | 24h — a scheduled iperf3 test
SCHED_HOST=                          # …to this device (address or name)
SCHED_PORT=5201                      # …on this port
SCHED_PROTO=tcp                      # tcp | udp
SCHED_DIR=both                       # up (Synology → device) | down (device → Synology) | both
SCHED_SECS=10                        # seconds per direction
SCHED_STREAMS=1                      # parallel streams
SCHED_RATE=100                       # UDP only: Mbit/s to send
THRESHOLD=0                          # Mbit/s: a scheduled result below this is reported; 0 never
ALERT=1                              # 1: a DSM notification when a scheduled test is slow or fails
KEEP_DAYS=365                        # results older than this are removed; 0 keeps them all
